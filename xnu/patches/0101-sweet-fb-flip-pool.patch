-		g_dpu.orig_dst_size = dst;
-		g_dpu.orig_src_xy = src_xy;
-		g_dpu.cur_src_size = src;
-		g_dpu.cur_w = fb_width;
-		g_dpu.cur_h = fb_height;
-		if (dpu_size_lo(dst, SWEET_SIZE_MINUS1) == fb_width &&
-		    dpu_size_hi(dst, SWEET_SIZE_MINUS1) == fb_height) {
