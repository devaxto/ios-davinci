+sweet_display_can_flip(void)
+{
+	return false;
+}
+
+bool
+sweet_display_flip(uint32_t phys, uint32_t stride, uint32_t x, uint32_t y,
+    uint32_t width, uint32_t height)
+{
+	(void)phys;
+	(void)stride;
+	(void)x;
+	(void)y;
+	(void)width;
+	(void)height;
+	return false;
+}
