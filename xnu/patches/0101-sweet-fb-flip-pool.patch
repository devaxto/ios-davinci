-bool
-sweet_display_can_flip(void)
-{
-	return g_dpu.ready && !g_dpu.disabled &&
-	    g_dpu.mdss != 0 && g_dpu.ctl_bits != 0;
-}
-
-/* Put the plane back exactly as the bootloader left it (panel PA, geometry). */
-static void
-dpu_restore(void)
-{
-	if (!g_dpu.ready || g_dpu.mdss == 0) {
-		return;
-	}
