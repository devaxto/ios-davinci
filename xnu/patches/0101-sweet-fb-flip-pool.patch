-	IOLog("SWEET DPU: panel 0x%llx %ux%u stride %u\n",
-	    (unsigned long long)fb_phys, fb_width, fb_height, fb_stride);
-	IOLog("SWEET DPU: mdp 0x%08x sde rev 0x%08x\n", MDSS_PA,
-	    dpu_rd(mdss, MDSS_SDE_OFF));
