+/*
+ * Physically contiguous PA of the pixel bytes (offset applied), or 0 if the
+ * backing store is not a single 32-bit-addressable contiguous region. Used by
+ * the DPU flip path (docs/GPU.md): the display controller has no SMMU map for
+ * arbitrary RAM, so only these surfaces can be scanned out directly.
+ */
+uint64_t sweet_surface_phys(SweetSurface *s);
+
+/*
+ * Carve the ABL splash region (disp_rdump_region, typically 24 MB at
+ * 0x9c000000) into slots the DPU can already scan. Full-screen IOSurfaces
+ * are allocated from those slots so CoreAnimation draws into memory the
+ * display controller can flip to - no expensive contiguous DRAM alloc.
+ * Slot 0 is the live panel (owned by AppleCLCD); CA gets 1..N-1.
+ */
+void sweet_surface_set_splash_pool(uint64_t phys, uint32_t region_bytes,
+    uint32_t slot_bytes);
+
+/*
+ * Reserve count physically contiguous, 32-bit-addressable buffers of slot_bytes
+ * for full-screen layers. The ABL carve-out holds a single CA-sized slot, so a
+ * compositor that rotates two surfaces made only every other frame flippable
