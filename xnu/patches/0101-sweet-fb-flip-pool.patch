-	}
-	IOLog("SWEET DPU: mdp dump %u words, %u nonzero\n", words, nonzero);
-
-	for (unsigned int i = 0; i < sizeof(kDpuBlocks) / sizeof(kDpuBlocks[0]); i++) {
