-		return kSizeEnc[g_dpu.size_enc - 1].minus1 ? "w-high,s-1" : "w-high";
-	}
-	return kSizeEnc[g_dpu.size_enc - 1].minus1 ? "w-low,s-1" : "w-low";
-}
