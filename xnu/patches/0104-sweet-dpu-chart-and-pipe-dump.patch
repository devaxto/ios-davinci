+	{ "vig1",  0x07000u, 0x1f0u, false, (1u << 1) },
+	{ "dma0",  0x25000u, 0x1f0u, false, (1u << 11) },
+	{ "dma1",  0x27000u, 0x1f0u, false, (1u << 12) },
+	{ "dma2",  0x29000u, 0x1f0u, false, (1u << 24) },
