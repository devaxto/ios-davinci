-	for (uint32_t i = 0; i < n; i++) {
-		after[i] = dpu_rd(base, b->off + 4 * i);
-		if (after[i] == before[i]) {
-			continue;
-		}
-		moved++;
-		if (g_dpu_verbose >= 2 && shown < 4) {
-			shown++;
-			IOLog("SWEET DPU: %s+0x%03x moved 0x%08x -> 0x%08x\n",
-			    b->name, 4 * i, before[i], after[i]);
