+			    args->scalarInputCount > 1 ? (unsigned long long)args->scalarInput[1] : 0ULL,
+			    args->scalarInputCount > 2 ? (unsigned long long)args->scalarInput[2] : 0ULL,
+			    (unsigned long long)fFB->fPresents);
+		}
+		break;
+	}
+	default:
+		break;
+	}
