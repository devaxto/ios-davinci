+	{ "intf1", 0x6b800u, 0x100u, true,  0 },
+	{ "intf2", 0x6c000u, 0x100u, true,  0 },
+	{ "intf3", 0x6c800u, 0x100u, true,  0 },
+	{ "pp0",   0x71000u, 0x0d4u, true,  0 },
+	{ "pp1",   0x71800u, 0x0d4u, true,  0 },
+	{ "pp2",   0x72000u, 0x0d4u, true,  0 },
+	{ "pp3",   0x72800u, 0x0d4u, true,  0 },
