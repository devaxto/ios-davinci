+static void
+dpu_dump_block(vm_offset_t base, const struct sweet_dpu_block *b,
+    uint32_t fb_pa, uint32_t fb_stride, uint32_t *words, uint32_t *nonzero)
+{
+	for (uint32_t off = 0; off + 4 <= b->len; off += 4) {
+		uint32_t v = dpu_rd(base, b->off + off);
