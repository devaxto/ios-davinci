+/*
+ * 0103/0104 diagnostics. A flipped frame comes out as noise for one of two
+ * very different reasons: the surface the plane was pointed at never held a
+ * frame (the renderer draws somewhere else, or not yet), or the plane does
+ * not fetch what the CPU can read at that physical address and pitch.
+ * sweetfb_probe=N logs what the surface holds (zero/opaque counts, a few
+ * pixels per row) and sweetfb_chart=N replaces the next N flips with a
+ * twelve-band colour chart framed by 8 px rulers: the chart is what tells the
+ * two apart. Twelve bands and four rulers mean the fetch is 1:1 whatever was
+ * there before; four bands mean the plane is scanning a third of the source;
+ * no chart at all means this address is not what the panel shows.
+ */
+static int32_t sweet_fb_probe_left = -1;
+static int32_t sweet_fb_chart_left = -1;
+
+static uint32_t
+sweet_fb_boot_u32(const char *name, uint32_t def)
+{
+	uint32_t v = def;
+
+	if (!PE_parse_boot_argn(name, &v, sizeof(v))) {
+		return def;
+	}
+	return v;
+}
+
+static void
+sweet_fb_probe_rows(const char *tag, const uint8_t *base, uint32_t bpr,
+    uint32_t w, uint32_t y)
+{
+	const uint32_t *p = (const uint32_t *)(base + (uint64_t)y * bpr);
+	uint32_t c[4];
+
+	for (uint32_t i = 0; i < 4; i++) {
+		c[i] = p[(uint64_t)w * i / 4];
+	}
+	IOLog("SWEET FB: probe %s y %u x0/25/50/75 0x%08x 0x%08x 0x%08x 0x%08x\n",
+	    tag, y, c[0], c[1], c[2], c[3]);
+}
+
+static void
+sweet_fb_probe_surface(const uint8_t *base, uint32_t bpr, uint32_t w,
+    uint32_t h)
+{
+	uint32_t zero = 0, opaque = 0, n = 0, first = 0, last = 0;
+
+	for (uint32_t y = 0; y < h; y += 16) {
+		const uint32_t *p = (const uint32_t *)(base + (uint64_t)y * bpr);
+
+		for (uint32_t x = 0; x < w; x += 16) {
+			uint32_t v = p[x];
+
+			if (v == 0) {
+				zero++;
+			}
+			if ((v >> 24) == 0xffu) {
+				opaque++;
+			}
+			if (n == 0) {
+				first = v;
+			}
+			last = v;
+			n++;
+		}
+	}
+	IOLog("SWEET FB: probe %ux%u bpr %u %u samples, %u zero, %u opaque, "
+	    "first 0x%08x last 0x%08x\n", w, h, bpr, n, zero, opaque, first, last);
+	sweet_fb_probe_rows("top", base, bpr, w, 0);
+	sweet_fb_probe_rows("mid", base, bpr, w, h / 2);
+	sweet_fb_probe_rows("end", base, bpr, w, h - 1);
+}
+
+/*
+ * Twelve horizontal bands in a fixed colour order (red at the top, black at
+ * the bottom) with 8 px white rulers on all four edges. Anything the plane
+ * shows that is not these twelve bands in this order is not the buffer at the
+ * address and pitch we programmed:
+ *
+ *  12 bands + 4 rulers  fetch is 1:1, the earlier noise was buffer content
+ *  4 bands + no rulers  the plane scans a third of the source (a scaler)
+ *  bands, no rulers     pitch or window is off
+ *  no bands             this address is not what the panel shows
+ *
+ * The bands are written over the whole surface, so the answer does not
+ * depend on what CoreAnimation had drawn there.
+ */
+static const uint32_t kChartBands[12] = {
+	0xff0000ffu, 0xff00ff00u, 0xffff0000u, 0xffffffffu,
+	0xff00ffffu, 0xffffff00u, 0xffff00ffu, 0xff0080ffu,
+	0xffff0080u, 0xff808080u, 0xff202020u, 0xff000000u,
+};
+
+static void
+sweet_fb_chart(uint8_t *dst, uint32_t bpr, uint32_t w, uint32_t h)
+{
+	for (uint32_t y = 0; y < h; y++) {
+		uint32_t *p = (uint32_t *)(dst + (uint64_t)y * bpr);
+		uint32_t v = kChartBands[(uint64_t)y * 12u / h];
+		bool ruler = (y < 8u || y + 8u >= h);
+
+		for (uint32_t x = 0; x < w; x++) {
+			p[x] = (ruler || x < 8u || x + 8u >= w) ? 0xffffffffu : v;
+		}
+	}
+	IOLog("SWEET FB: chart %ux%u bpr %u, 12 bands + 8 px white rulers\n",
+	    w, h, bpr);
+}
+
+/*
+ * Zero-copy present: point the live SSPP at the CA surface and let the DPU
+ * fetch it. The bootloader's pipeline is kept (same format, same panel-sized
+ * source window, same mixers); only SRC_ADDR, SRC_YSTRIDE0 and SRC_XY move,
+ * so a bad guess costs one frame instead of the panel - and sweet_display_*
+ * restores the splash buffer and disables the flip if the write does not
+ * latch.
+ *
+ * The window is exactly the one the CPU crop-copy below uses: a full panel
+ * rect, cropped out of a larger logical surface when CoreAnimation draws
+ * 1125x2436 for the 1080x2340 panel. That is what makes native and logical
+ * mode flip the same way, and it is why the surface pitch (4320/4352/4608)
+ * must be programmed as YSTRIDE instead of the ABL's 4320.
+ */
+static bool
+sweet_fb_try_flip(AppleCLCD *fb, const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	uint32_t found = 0, id = 0;
+	int32_t sx, sy, ldx, ldy, lw, lh;
+	uint32_t crop_x, crop_y;
+	const uint8_t *a, *b;
+	SweetSurface *s;
+	uint64_t phys;
+	uintptr_t src;
+	static uint32_t flip_logged;
+
+	if (fb->fFlipMode == 0 || !sweet_display_can_flip()) {
+		return false;
+	}
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if (!(mask & (1u << layer))) {
+			continue;
+		}
+		id = get32(rec, 0x54 + 4 * layer);
+		if (id == 0) {
+			continue;
+		}
+		found++;
+		if (found > 1) {
+			return false;
+		}
+		a = rec + 0x64 + 16 * layer;
+		b = rec + 0xc4 + 16 * layer;
+		sx = (int32_t)get32(a, 0);
+		sy = (int32_t)get32(a, 4);
+		ldx = (int32_t)get32(b, 0);
+		ldy = (int32_t)get32(b, 4);
+		lw = (int32_t)get32(b, 8);
+		lh = (int32_t)get32(b, 12);
+	}
+	if (found != 1) {
+		return false;
+	}
+	s = sweet_surface_copy(id);
+	if (s == NULL || s == fb->fSurface) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	if (lw <= 0 || lh <= 0) {
+		lw = (int32_t)s->width;
+		lh = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0 ||
+	    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1) {
+		s->release();
+		return false;
+	}
+
+	crop_x = 0;
+	crop_y = 0;
+	if (ldx == 0 && ldy == 0 &&
+	    lw == (int32_t)fb->fLogicalW && lh == (int32_t)fb->fLogicalH &&
+	    sx == 0 && sy == 0 &&
+	    s->width >= fb->fOffX + (int32_t)fb->fWidth &&
+	    s->height >= fb->fOffY + (int32_t)fb->fHeight) {
+		/* Logical-size layer: the panel is its centered window. */
+		crop_x = (uint32_t)fb->fOffX;
+		crop_y = (uint32_t)fb->fOffY;
+	} else if (ldx == fb->fOffX && ldy == fb->fOffY &&
+	    lw == (int32_t)fb->fWidth && lh == (int32_t)fb->fHeight &&
+	    s->width >= (uint32_t)sx + fb->fWidth &&
+	    s->height >= (uint32_t)sy + fb->fHeight) {
+		/* Dest is the panel itself; the record may still offset the source. */
+		crop_x = (uint32_t)sx;
+		crop_y = (uint32_t)sy;
+	} else {
+		s->release();
+		return false;
+	}
+
+	phys = sweet_surface_phys(s);
+	src = s->kernelAddress();
+	if (phys == 0 || phys > 0xffffffffull || src == 0) {
+		s->release();
+		return false;
+	}
+	if (s->bytesPerRow == 0 || s->bytesPerRow > 0xffffu) {
+		s->release();
+		return false;
+	}
+	if (s->memory == NULL ||
+	    (uint64_t)s->bytesPerRow * s->height > s->memory->getLength()) {
+		s->release();
+		return false;
+	}
+	if (sweet_fb_probe_left < 0) {
+		sweet_fb_probe_left = (int32_t)sweet_fb_boot_u32("sweetfb_probe", 3);
+		sweet_fb_chart_left =
+		    (int32_t)sweet_fb_boot_u32("sweetfb_chart", 0);
+	}
+	if (sweet_fb_probe_left > 0) {
+		sweet_fb_probe_left--;
+		sweet_fb_probe_surface((const uint8_t *)(src + s->offset +
+		    (uint64_t)crop_y * s->bytesPerRow + (uint64_t)crop_x * 4u),
+		    s->bytesPerRow, fb->fWidth, fb->fHeight);
+	}
+	if (sweet_fb_chart_left > 0) {
+		sweet_fb_chart_left--;
+		sweet_fb_chart((uint8_t *)(src + s->offset +
+		    (uint64_t)crop_y * s->bytesPerRow + (uint64_t)crop_x * 4u),
+		    s->bytesPerRow, fb->fWidth, fb->fHeight);
+	}
+	sweet_fb_clean_rows(src + s->offset + (uint64_t)crop_y * s->bytesPerRow +
+	    (uint64_t)crop_x * 4u, (size_t)fb->fWidth * 4u,
+	    (int32_t)fb->fHeight, s->bytesPerRow);
+	if (!sweet_display_flip((uint32_t)phys, s->bytesPerRow, crop_x, crop_y,
+	    fb->fWidth, fb->fHeight)) {
+		s->release();
+		return false;
+	}
+	fb->fFlips++;
+	fb->fFrameBytes = 0;
+	if (flip_logged < 8) {
+		flip_logged++;
+		IOLog("SWEET FB: flip surface %u pa 0x%llx crop %u,%u stride %u "
+		    "panel %ux%u\n",
+		    s->id, (unsigned long long)phys, crop_x, crop_y,
+		    s->bytesPerRow, fb->fWidth, fb->fHeight);
+	}
+	s->release();
+	return true;
+}
+
+/*
+ * Hot path when flip cannot run: CA's 1125x2436 layer -> copy only the
+ * centered panel window into the ABL buffer the DPU already scans.
+ * Beats the generic clipper (less branches, one tight row loop).
+ */
+static bool
+sweet_fb_try_crop_copy(AppleCLCD *fb, const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	uint32_t found = 0, id = 0;
+	int32_t sx, sy, ldx, ldy, lw, lh;
+	uint32_t crop_x, crop_y;
+	const uint8_t *a, *b;
+	SweetSurface *s;
+	uintptr_t src, dst;
+	const uint8_t *from;
+	size_t row;
+	static uint32_t crop_logged;
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if (!(mask & (1u << layer))) {
+			continue;
+		}
+		id = get32(rec, 0x54 + 4 * layer);
+		if (id == 0) {
+			continue;
+		}
+		found++;
+		if (found > 1) {
+			return false;
+		}
+		a = rec + 0x64 + 16 * layer;
+		b = rec + 0xc4 + 16 * layer;
+		sx = (int32_t)get32(a, 0);
+		sy = (int32_t)get32(a, 4);
+		ldx = (int32_t)get32(b, 0);
+		ldy = (int32_t)get32(b, 4);
+		lw = (int32_t)get32(b, 8);
+		lh = (int32_t)get32(b, 12);
+	}
+	if (found != 1 || fb->fPixels == 0) {
+		return false;
+	}
+	s = sweet_surface_copy(id);
+	if (s == NULL || s == fb->fSurface) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	if (lw <= 0 || lh <= 0) {
+		lw = (int32_t)s->width;
+		lh = (int32_t)s->height;
+	}
+	if (s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1) {
+		s->release();
+		return false;
+	}
+
+	if (ldx == 0 && ldy == 0 &&
+	    lw == (int32_t)fb->fLogicalW && lh == (int32_t)fb->fLogicalH &&
+	    sx == 0 && sy == 0) {
+		crop_x = (uint32_t)fb->fOffX;
+		crop_y = (uint32_t)fb->fOffY;
+	} else if (ldx == fb->fOffX && ldy == fb->fOffY &&
+	    lw == (int32_t)fb->fWidth && lh == (int32_t)fb->fHeight) {
+		crop_x = (uint32_t)sx;
+		crop_y = (uint32_t)sy;
+	} else {
+		s->release();
+		return false;
+	}
+	if (s->width < crop_x + fb->fWidth || s->height < crop_y + fb->fHeight) {
+		s->release();
+		return false;
+	}
+	src = s->kernelAddress();
+	if (src == 0) {
+		s->release();
+		return false;
+	}
+
+	row = (size_t)fb->fWidth * 4u;
+	dst = fb->fPixels;
+	from = (const uint8_t *)(src + s->offset +
+	    (uint64_t)crop_y * s->bytesPerRow + (uint64_t)crop_x * 4u);
+	if (s->bytesPerRow == fb->fRowBytes && crop_x == 0) {
+		memcpy((void *)dst, from, row * (size_t)fb->fHeight);
+	} else {
+		for (uint32_t y = 0; y < fb->fHeight; y++) {
+			memcpy((void *)(dst + (uint64_t)y * fb->fRowBytes),
+			    from + (uint64_t)y * s->bytesPerRow, row);
+		}
+	}
+	fb->fFrameBytes = (uint64_t)row * fb->fHeight;
+	if (fb->fCacheMode != 0) {
+		sweet_fb_clean_rows(dst, row, (int32_t)fb->fHeight, fb->fRowBytes);
+	}
+	if (crop_logged < 4) {
+		crop_logged++;
+		IOLog("SWEET FB: crop-copy surface %u %ux%u -> panel %ux%u "
+		    "(%u KB)\n",
+		    s->id, s->width, s->height, fb->fWidth, fb->fHeight,
+		    (uint32_t)(fb->fFrameBytes / 1024u));
+	}
+	s->release();
+	return true;
+}
+
+/* Copy each enabled layer's surface into the panel memory (no scaling). */
+void
+AppleCLCD::present(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+
+	if (!fConsolePaused) {
+		int quiet = 0;
+		fConsolePaused = true;
+		if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics. */
+			sweet_console_muted = 1;
+		}
+	}
+
+	if (sweet_fb_try_flip(this, rec)) {
+		return;
+	}
+	/*
+	 * A previous frame may have left the plane on a CA surface. Point it back
+	 * at the splash buffer before copying into it, or this frame would paint
+	 * memory nobody scans out (and the panel would freeze on the old flip).
+	 * Cheap no-op when the plane was never moved.
+	 */
+	sweet_display_flip_reset();
+	if (sweet_fb_try_crop_copy(this, rec)) {
+		return;
+	}
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (sweet_fb_swaps_logged < 16) {
+			sweet_fb_swaps_logged++;
+			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		/* Logical (presented) display coordinates -> panel coordinates. */
+		dx -= fOffX;
+		dy -= fOffY;
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fWidth - dx) {
+			w = (int32_t)fWidth - dx;
+		}
+		if (h > (int32_t)fHeight - dy) {
+			h = (int32_t)fHeight - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0 && bpe == 4) {
+			size_t row = (size_t)w * 4;
+			uintptr_t dst = fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4;
+			const uint8_t *from = (const uint8_t *)(src + s->offset +
+			    (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4);
+
+			fFrameBytes += (uint64_t)row * (uint64_t)h;
+			if (row == fRowBytes && row == s->bytesPerRow) {
+				/* Full-width layer: one big memcpy beats per-row calls. */
+				memcpy((void *)dst, from, row * (size_t)h);
+			} else {
+				for (int32_t y = 0; y < h; y++) {
+					memcpy((void *)(dst + (uint64_t)y * fRowBytes),
+					    from + (uint64_t)y * s->bytesPerRow, row);
+				}
+			}
+			if (fCacheMode != 0) {
+				sweet_fb_clean_rows(dst, row, h, fRowBytes);
+			}
+		}
+		s->release();
+	}
+}
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= SWEET_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kSweetFBGetLayerDefaultSurface:
+		out[0] = sweet_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kSweetFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
