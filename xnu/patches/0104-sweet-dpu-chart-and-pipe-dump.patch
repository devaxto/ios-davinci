+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kSweetFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kSweetFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kSweetFBGetDotPitch:
+		out[0] = SWEET_FB_DOT_PITCH;
